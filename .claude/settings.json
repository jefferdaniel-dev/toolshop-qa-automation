{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(playwright install:*)",
      "Bash(python -m playwright install:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(py -3.15 -m venv .venv)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/Scripts/python -m pip install:*)",
      "Bash(.venv/Scripts/python -m playwright install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(Get-Content .env:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git commit:*)",
      "PowerShell(git commit:*)",
      "Bash(gh repo:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "PowerShell(gh repo:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh release:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.15 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30,
            "statusMessage": "Revisando reglas de seguridad"
          }
        ]
      }
    ]
  }
}
